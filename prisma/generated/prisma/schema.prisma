model Artist {
  id        String   @id @default(cuid())
  name      String
  bio       String?
  imageUrl  String?  @map("image_url")
  events    Event[]  @relation("EventToArtist")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@map("artists")
}

model City {
  id   String @id @default(cuid())
  name String @unique

  events Event[]
  users  User[]
  venues Venue[]

  @@index([name])
}

model Collection {
  id          String   @id @default(cuid())
  title       String
  description String?
  coverUrl    String?  @map("cover_url")
  events      Event[]  @relation("EventToCollection")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("collections")
}

enum EventType {
  cinema
  concert
  kids
  standup
  theater
  sport
}

enum EventStatus {
  DRAFT
  MODERATING
  PUBLISHED
  CANCELLED
}

model Event {
  id          String @id @default(cuid())
  title       String
  description String
  imageUrl    String @map("image_url")

  cityId String? @map("city_id")
  city   City?   @relation(references: [id], fields: [cityId])

  venueId String? @map("venue_id")
  venue   Venue?  @relation(fields: [venueId], references: [id])

  location String? @map("event_location")

  date         DateTime @map("event_date")
  price        Int
  ticketAmount Int      @default(100) @map("ticket_amount")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt() @map("updated_at")

  genre  EventType @default(concert)
  rating Float     @default(0)

  duration       Int         @default(120)
  ageRestriction String      @default("0+") @map("age_restriction")
  status         EventStatus @default(DRAFT)
  isModerated    Boolean     @default(false) @map("is_moderated")

  organizerId String? @map("organizer_id")
  organizer   User?   @relation("EventOrganizer", fields: [organizerId], references: [id])

  tickets     Ticket[]
  artists     Artist[]     @relation("EventToArtist")
  collections Collection[] @relation("EventToCollection")
  favorites   Favorite[]
  reviews     Review[]
  promoCodes  PromoCode[]

  @@index([organizerId])
  @@index([venueId])
  @@index([createdAt])
  @@index([date])
  @@index([price])
  @@index([cityId])
  @@index([cityId, date])
  @@index([title])
  @@index([status])
  @@map("events")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   String   @map("event_id")
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
  @@map("favorites")
}

enum NotificationType {
  SYSTEM
  ORDER
  EVENT_UPDATE
  PROMO
}

model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

enum OrderStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

model Order {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  totalAmount Int         @map("total_amount")
  status      OrderStatus @default(PENDING)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tickets Ticket[]
  payment Payment?

  @@index([userId])
  @@map("orders")
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

model Payment {
  id String @id @default(cuid())

  orderId String @unique @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  amount        Int
  currency      String  @default("RUB")
  provider      String  @default("stripe")
  transactionId String? @unique @map("transaction_id")

  status PaymentStatus @default(PENDING)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("payments")
}

model PromoCode {
  id        String    @id @default(cuid())
  code      String    @unique
  discount  Int // Percentage or fixed amount
  maxUses   Int?      @map("max_uses")
  usedCount Int       @default(0) @map("used_count")
  expiresAt DateTime? @map("expires_at")
  eventId   String?   @map("event_id")
  event     Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([code])
  @@index([eventId])
  @@map("promo_codes")
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
}

model RefundRequest {
  id        String       @id @default(cuid())
  ticketId  String       @unique @map("ticket_id")
  ticket    Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  reason    String
  status    RefundStatus @default(PENDING)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@map("refund_requests")
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  text      String?
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   String   @map("event_id")
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, eventId])
  @@index([eventId])
  @@index([userId])
  @@map("reviews")
}

