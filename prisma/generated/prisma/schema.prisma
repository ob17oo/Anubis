generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TicketStatus {
  CONFIRMED
  CANCELLED
}

model Ticket {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  eventId String @map("event_id")
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  orderId String? @map("order_id")
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  quantity   Int          @default(1)
  totalPrice Int          @map("price")
  status     TicketStatus @default(CONFIRMED)

  createdAt DateTime @default(now()) @map("created_at")
  qrCode    String?  @unique @map("qr_code") // Unique identifier for the ticket

  refundRequest RefundRequest?

  @@index([orderId])
  @@index([eventId])
  @@index([userId])
  @@map("tickets")
}

enum USER_ROLE {
  ADMIN
  USER
  MODERATOR
  ORGANIZER
}

model User {
  id       String @id @default(cuid())
  userName String @map("user_name")
  password String

  cityId String? @map("city_id")
  city   City?   @relation(references: [id], fields: [cityId])

  email    String    @unique
  imageUrl String    @default("/static/default/default-user.svg") @map("image_url")
  role     USER_ROLE @default(USER)

  orders          Order[]
  tickets         Ticket[]
  favorites       Favorite[]
  reviews         Review[]
  notifications   Notification[]
  organizedEvents Event[]        @relation("EventOrganizer")

  @@index([role])
  @@index([email])
  @@index([cityId])
}

model Venue {
  id        String   @id @default(cuid())
  name      String
  address   String
  capacity  Int?
  cityId    String   @map("city_id")
  city      City     @relation(fields: [cityId], references: [id])
  events    Event[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([cityId])
  @@map("venues")
}
