model Collection {
  id          String   @id @default(cuid())
  title       String
  description String?
  coverUrl    String?  @map("cover_url")
  events      Event[]  @relation("EventToCollection")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("collections")
}
