enum TicketStatus {
  CONFIRMED
  CANCELLED
}

model Ticket {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  eventId String @map("event_id")
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  ticketTypeId String?     @map("ticket_type_id")
  ticketType   TicketType? @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)

  orderId String? @map("order_id")
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  quantity Int          @default(1)
  totalPrice    Int          @map("price")
  status   TicketStatus @default(CONFIRMED)

  createdAt DateTime @default(now()) @map("created_at")
  qrCode    String?  @unique @map("qr_code") // Unique identifier for the ticket

  refundRequest RefundRequest?

  @@index([orderId])
  @@index([eventId])
  @@index([userId])
  @@map("tickets")
}
