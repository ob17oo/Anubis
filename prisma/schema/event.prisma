enum EventType {
  cinema
  concert
  kids
  standup
  theater
  sport
  festival
  exhibition
  conference
}

enum EventStatus {
  DRAFT
  MODERATING
  PUBLISHED
  CANCELLED
}

model Event {
  id          String @id @default(cuid())
  title       String
  description String
  imageUrl    String @map("image_url")

  cityId String? @map("city_id")
  city   City?   @relation(references: [id], fields: [cityId])

  venueId String? @map("venue_id")
  venue   Venue?  @relation(fields: [venueId], references: [id])

  location String? @map("event_location")

  date         DateTime @map("event_date")
  price        Int
  ticketAmount Int      @default(100) @map("ticket_amount")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt() @map("updated_at")

  genre  EventType @default(concert)
  rating Float     @default(0)

  duration       Int         @default(120)
  ageRestriction String      @default("0+") @map("age_restriction")
  status         EventStatus @default(DRAFT)
  isModerated    Boolean     @default(false) @map("is_moderated")

  organizerId    String?     @map("organizer_id")
  organizer      User?       @relation("EventOrganizer", fields: [organizerId], references: [id])

  tickets     Ticket[]
  ticketTypes TicketType[]
  artists     Artist[]     @relation("EventToArtist")
  collections Collection[] @relation("EventToCollection")
  favorites   Favorite[]
  reviews     Review[]
  promoCodes  PromoCode[]

  @@index([organizerId])
  @@index([venueId])
  @@index([createdAt])
  @@index([date])
  @@index([price])
  @@index([cityId])
  @@index([cityId, date])
  @@index([title])
  @@index([status])
  @@map("events")
}
